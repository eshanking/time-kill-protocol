inspect_diff <- function(f) {
a <- readLines(file.path("original_unzipped", f), warn = FALSE)
b <- readLines(file.path("written_unzipped",  f), warn = FALSE)
cat("=== ORIGINAL ===\n"); cat(a, sep = "\n")
cat("\n=== WRITTEN ===\n");  cat(b, sep = "\n")
}
